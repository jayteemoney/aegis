# dependencies
/node_modules
/ui/node_modules

# frontend build output
/ui/dist
/ui/.vite

# Compact build artifacts (regenerated by `yarn compile`)
/contracts/managed
# ...except the generated contract interface. The frontend imports it at build
# and run time, and a hosting build machine cannot run the Compact compiler, so
# a hosted deployment needs it committed. 84KB, and it is the only piece of
# compiler output the interface actually depends on.
!/contracts/managed/
!/contracts/managed/aegis/
!/contracts/managed/aegis/contract/
!/contracts/managed/aegis/contract/**
# Everything else the compiler emits stays out. Un-ignoring the parent
# directory above re-exposes its siblings, so name them explicitly: the proving
# keys are 5.2MB of high-entropy material needed only to submit a transaction,
# which a hosted build has no chain to submit to.
/contracts/managed/aegis/keys/
/contracts/managed/aegis/zkir/
/contracts/managed/aegis/compiler/
/contracts/managed/aegis-check/
# The same ZK material, republished for the browser by `yarn zk:copy`
/ui/public/zk

# logs & local state
/logs
/midnight-level-db
/.midnight-expert

# ── SECRETS: never commit ──────────────────────────────────────────────
# Deployed contract addresses / deploy output
deployment.json
# Wallet seeds, mnemonics and any network credentials
.env
.env.*
!.env.example
!.env.*.example
*.seed
*.mnemonic
seed.txt
wallet-seed*
# ───────────────────────────────────────────────────────────────────────

# editor / OS
.DS_Store
.vscode/*
!.vscode/extensions.json

# ── hosting ────────────────────────────────────────────────────────────
# Vercel's project link and the OIDC token it downloads. Appended by the
# CLI, kept here rather than at the end of the file so its `.env` rule does
# not silently override the example-file exceptions above.
/.vercel
.env.local
